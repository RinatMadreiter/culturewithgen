---
// The whole landing page for both locales. Owns the sections rather than
// exposing a <slot>, which would duplicate the section list in both pages.
import type { z } from "astro/zod";
import type { landingSchema } from "../lib/content-schema";

import "../styles/global.css";

import Seo from "../components/Seo.astro";
import StructuredData from "../components/StructuredData.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import Hero from "../components/sections/Hero.astro";
import Offer from "../components/sections/Offer.astro";
import About from "../components/sections/About.astro";
import WhoFor from "../components/sections/WhoFor.astro";
import Situations from "../components/sections/Situations.astro";
import Formats from "../components/sections/Formats.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Contact from "../components/sections/Contact.astro";

import { type Locale, UI, HOME_HREF } from "../lib/i18n";
import { CONTACT_FORM_URLS } from "../lib/links";

type LandingContent = z.infer<typeof landingSchema>;

interface Props {
  locale: Locale;
  content: LandingContent;
}

const { locale, content } = Astro.props;

const t = UI[locale];
const path = HOME_HREF[locale];
const contactFormUrl = CONTACT_FORM_URLS[locale];

// Shared by all three CTAs (nav, hero, contact) so they cannot disagree.
const ctaLabel = content.header.ctaLabel;

const showTestimonials =
  !!content.testimonials && content.testimonials.visible !== false;

// Blank CMS override falls back to the built-in label, never an empty link.
const navLabel = (key: keyof typeof t.nav) =>
  content.nav?.[key]?.trim() || t.nav[key];

const navLinks = [
  { label: navLabel("services"), href: "#services" },
  { label: navLabel("about"), href: "#about" },
  { label: navLabel("workshops"), href: "#formats" },
  ...(showTestimonials
    ? [{ label: navLabel("testimonials"), href: "#testimonials" }]
    : []),
];

const seoTitle = content.seo?.title?.trim() || t.seo.title;
const seoDescription = content.seo?.description?.trim() || t.seo.description;
---

<html class="light" lang={locale}>
  <head>
    <Seo
      title={seoTitle}
      description={seoDescription}
      locale={locale}
      path={path}
      alternates={HOME_HREF}
    />
    <StructuredData
      locale={locale}
      path={path}
      offerItems={content.offer.items}
      description={seoDescription}
    />
  </head>

  <body class="antialiased overflow-x-hidden flex flex-col min-h-screen">
    <Navigation
      homeHref={path}
      links={navLinks}
      ctaLabel={ctaLabel}
      contactFormUrl={contactFormUrl}
    />

    <main class="pt-16 md:pt-40 flex-1">
      <Hero {...content.header} contactFormUrl={contactFormUrl} />
      <Offer {...content.offer} />
      <About {...content.about} />
      <WhoFor {...content.whoFor} />
      <Situations {...content.situations} />
      <Formats {...content.format} />
      {showTestimonials && <Testimonials {...content.testimonials!} />}
      <Contact
        {...content.contact}
        ctaLabel={ctaLabel}
        contactFormUrl={contactFormUrl}
      />
    </main>

    <Footer locale={locale} />

    <BackToTop locale={locale} />
  </body>
</html>
