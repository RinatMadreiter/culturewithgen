---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";

import { type Locale, UI, HOME_HREF } from "../lib/i18n";
import { SITE_NAME } from "../lib/site";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  path: string;
  alternates?: Partial<Record<Locale, string>>;
}

const { lang, title, description, path, alternates } = Astro.props;

const homeHref = HOME_HREF[lang];
const { backLabel, homeAriaLabel } = UI[lang].legal;
---

<html lang={lang}>
  <head>
    <Seo
      title={`${title} | ${SITE_NAME}`}
      description={description}
      locale={lang}
      path={path}
      alternates={alternates}
      type="article"
    />
    <style>
      :root {
        --ink: #1e3932;
        --muted: #475650;
        --accent: #9a442d;
        --page: #f4f7f5;
        --card: #ffffff;
        --line: rgba(30, 57, 50, 0.1);
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        line-height: 1.65;
        color: var(--muted);
        background-color: var(--page);
        margin: 0;
        padding: 0;
        /* Sticky footer: the imprint page is short enough to need it. */
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      /* Must mirror Navigation.astro's bar or the logo jumps between pages. */
      .site-header__inner {
        max-width: 80rem;
        margin: 0 auto;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      @media (min-width: 768px) {
        .site-header__inner {
          padding: 1rem 2rem;
        }
      }
      .logo-link {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        transition: transform 0.2s ease;
      }
      .logo-link:hover {
        transform: scale(1.05);
      }
      /* Must match Navigation.astro's logo sizing. */
      .logo-link img {
        height: 5rem;
        width: auto;
        object-fit: contain;
        border-radius: 1.5rem;
      }
      @media (min-width: 768px) {
        .logo-link img {
          height: 9rem;
        }
      }
      .back-link {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      main {
        width: 100%;
        box-sizing: border-box;
        max-width: 880px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
        flex: 1;
      }
      .legal-prose {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 2.5rem;
        box-shadow: 0 12px 40px rgba(30, 57, 50, 0.06);
        /* Long German compounds overflow the column and force h-scroll. */
        overflow-wrap: break-word;
      }
      .legal-prose h1 {
        color: var(--ink);
        font-size: 2rem;
        margin: 0 0 1.5rem;
        letter-spacing: -0.01em;
      }
      .legal-prose a {
        color: var(--accent);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="logo-link" href={homeHref} aria-label={homeAriaLabel}>
          {
            /* height must cover the largest rendered size (9rem) or it blurs. */
          }
          <Image
            src={logo}
            alt="CultureWithGen"
            height={144}
            densities={[1, 2]}
            loading="eager"
          />
        </a>
        <a class="back-link" href={homeHref}>← {backLabel}</a>
      </div>
    </header>
    <main>
      <article class="legal-prose">
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
    <Footer locale={lang} />
  </body>
</html>
