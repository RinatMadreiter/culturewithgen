---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";

import { type Locale, UI, HOME_HREF } from "../lib/i18n";
import { SITE_NAME } from "../lib/site";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  path: string;
  alternates?: Partial<Record<Locale, string>>;
}

const { lang, title, description, path, alternates } = Astro.props;

// Derived from `lang` rather than passed in: these were three more props each
// caller had to supply correctly, in the right language, every time.
const homeHref = HOME_HREF[lang];
const { backLabel, homeAriaLabel } = UI[lang].legal;
---

<html lang={lang}>
  <head>
    <Seo
      title={`${title} | ${SITE_NAME}`}
      description={description}
      locale={lang}
      path={path}
      alternates={alternates}
      type="article"
    />
    <style>
      :root {
        --ink: #1e3932;
        --muted: #475650;
        --accent: #9a442d;
        --page: #f4f7f5;
        --card: #ffffff;
        --line: rgba(30, 57, 50, 0.1);
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        line-height: 1.65;
        color: var(--muted);
        background-color: var(--page);
        margin: 0;
        padding: 0;
        /* Sticky footer: the imprint page is short enough that without this the
           footer would float mid-viewport with page background beneath it. */
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      /* Mirrors Navigation.astro's bar exactly (max-w-7xl, px-4 md:px-8, py-4)
         so the logo lands on the same pixel on the home and legal pages and
         does not jump when navigating between them. Deliberately wider than
         the 880px content column below it. */
      .site-header__inner {
        max-width: 80rem;
        margin: 0 auto;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      @media (min-width: 768px) {
        .site-header__inner {
          padding: 1rem 2rem;
        }
      }
      .logo-link {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        transition: transform 0.2s ease;
      }
      .logo-link:hover {
        transform: scale(1.05);
      }
      /* Sized to match Navigation.astro's logo (h-20 md:h-36 rounded-3xl) so
         the brand mark is identical across the home and legal pages. */
      .logo-link img {
        height: 5rem;
        width: auto;
        object-fit: contain;
        border-radius: 1.5rem;
      }
      @media (min-width: 768px) {
        .logo-link img {
          height: 9rem;
        }
      }
      .back-link {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      main {
        width: 100%;
        box-sizing: border-box;
        max-width: 880px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
        flex: 1;
      }
      .legal-prose {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 2.5rem;
        box-shadow: 0 12px 40px rgba(30, 57, 50, 0.06);
        /* Long German compounds ("Datenschutzerklärung",
           "Drittlandübermittlung") are wider than the content column on narrow
           screens and would otherwise push the whole page into horizontal
           scroll. Only affects words that cannot otherwise fit. */
        overflow-wrap: break-word;
      }
      .legal-prose h1 {
        color: var(--ink);
        font-size: 2rem;
        margin: 0 0 1.5rem;
        letter-spacing: -0.01em;
      }
      .legal-prose a {
        color: var(--accent);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="logo-link" href={homeHref} aria-label={homeAriaLabel}>
          <!-- Matches Navigation.astro: the intrinsic height must cover the
               largest rendered size (9rem) or the asset upscales and blurs. -->
          <Image
            src={logo}
            alt="CultureWithGen"
            height={144}
            densities={[1, 2]}
            loading="eager"
          />
        </a>
        <a class="back-link" href={homeHref}>← {backLabel}</a>
      </div>
    </header>
    <main>
      <article class="legal-prose">
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
    <Footer locale={lang} />
  </body>
</html>
