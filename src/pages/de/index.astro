---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

import "../../styles/global.css";

import Navigation from "../../components/Navigation.astro";
import ObfuscatedEmail from "../../components/ObfuscatedEmail.astro";
import Seo from "../../components/Seo.astro";
import StructuredData from "../../components/StructuredData.astro";
import logo from "../../assets/logo.webp";
import Hero from "../../components/sections/Hero.astro";
import Offer from "../../components/sections/Offer.astro";
import About from "../../components/sections/About.astro";
import WhoFor from "../../components/sections/WhoFor.astro";
import Situations from "../../components/sections/Situations.astro";
import Formats from "../../components/sections/Formats.astro";
import Contact from "../../components/sections/Contact.astro";
import BackToTop from "../../components/BackToTop.astro";

const entry = await getEntry("landing", "de");
if (!entry)
  throw new Error("Missing landing content: src/content/landing/de.json");
const content = entry.data;

// CTA-oriented description, both grounded in the page content. Each can be
// overridden via the CMS (content.seo); an empty/absent override falls back
// to the derived default below so nothing regresses when left blank.
const seoTitle =
  content.seo?.title?.trim() || `${content.header.eyebrow} | CultureWithGen`;
const seoDescription =
  content.seo?.description?.trim() ||
  "Praxisorientierte Workshops für interkulturelle Kommunikation in internationalen Teams - inhouse und online. Kontaktieren Sie mich für bessere Zusammenarbeit über Kulturen hinweg.";
---

<html class="light" lang="de">
  <head>
    <Seo
      title={seoTitle}
      description={seoDescription}
      locale="de"
      path="/de/"
      alternates={{ en: "/", de: "/de/" }}
    />
    <StructuredData
      locale="de"
      path="/de/"
      offerItems={content.offer.items}
      description={seoDescription}
    />
  </head>

  <body class="antialiased overflow-x-hidden flex flex-col min-h-screen">
    <Navigation
      homeHref="/de/"
      links={[
        { label: "Leistungen", href: "#services" },
        { label: "Über mich", href: "#about" },
        { label: "Workshops", href: "#formats" },
      ]}
      ctaLabel="Kontakt aufnehmen"
    />

    <main class="pt-16 md:pt-40 flex-1">
      <Hero {...content.header} />
      <Offer {...content.offer} />
      <About {...content.about} />
      <WhoFor {...content.whoFor} />
      <Situations {...content.situations} />
      <Formats {...content.format} />
      <Contact {...content.contact} />
    </main>

    <footer class="bg-[#1E3932] w-full border-t border-white/10 text-[#FAF9F6]">
      <div
        class="max-w-3xl mx-auto px-6 py-12 flex flex-col items-center gap-6 text-center"
      >
        <!-- Logo -->
        <a
          href="/de/"
          class="hover:opacity-80 transition-opacity"
          aria-label="CultureWithGen Startseite"
        >
          <Image
            src={logo}
            alt="CultureWithGen"
            height={96}
            densities={[1, 2]}
            class="rounded-3xl"
          />
        </a>

        <!-- Tagline -->
        <p
          class="text-xs uppercase tracking-widest text-[#FAF9F6]/70 font-semibold"
        >
          Interkulturelle Kommunikation & Zusammenarbeit
        </p>

        <!-- Email -->
        <ObfuscatedEmail
          email={content.contact.email}
          copyOnClick
          class="text-sm text-[#FAF9F6]/80 hover:text-[#E07A5F] transition-colors tracking-wide"
        />

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/genevieve-navisotschnig-40127b166/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn-Profil"
          class="text-[#FAF9F6]/70 hover:text-[#E07A5F] transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </a>

        <!-- Divider -->
        <div class="w-16 border-t border-white/10 mt-2"></div>

        <!-- Legal links + copyright -->
        <div
          class="flex flex-wrap justify-center gap-6 text-xs uppercase tracking-widest text-[#FAF9F6]/70"
        >
          <a
            href="/de/datenschutz"
            class="hover:text-[#E07A5F] transition-colors">Datenschutz</a
          >
          <a href="/de/impressum" class="hover:text-[#E07A5F] transition-colors"
            >Impressum</a
          >
        </div>
        <p class="text-xs text-[#FAF9F6]/60">
          © {new Date().getFullYear()} CultureWithGen
        </p>
      </div>
    </footer>

    <BackToTop locale="de" />
  </body>
</html>
