---
import { getEntry } from "astro:content";

import "../../styles/global.css";

import Navigation from "../../components/Navigation.astro";
import Seo from "../../components/Seo.astro";
import StructuredData from "../../components/StructuredData.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import Offer from "../../components/sections/Offer.astro";
import About from "../../components/sections/About.astro";
import WhoFor from "../../components/sections/WhoFor.astro";
import Situations from "../../components/sections/Situations.astro";
import Formats from "../../components/sections/Formats.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import Contact from "../../components/sections/Contact.astro";
import BackToTop from "../../components/BackToTop.astro";

const entry = await getEntry("landing", "de");
if (!entry)
  throw new Error("Missing landing content: src/content/landing/de.json");
const content = entry.data;

// Testimonials nav link is bound to the CMS `visible` toggle: it appears only
// while the section is shown, so the anchor never points at a hidden section.
const navLinks = [
  { label: "Leistungen", href: "#services" },
  { label: "Über mich", href: "#about" },
  { label: "Workshops", href: "#formats" },
];
if (content.testimonials && content.testimonials.visible !== false) {
  navLinks.push({ label: "Referenzen", href: "#testimonials" });
}

// CTA-oriented description, both grounded in the page content. Each can be
// overridden via the CMS (content.seo); an empty/absent override falls back
// to the derived default below so nothing regresses when left blank.
const seoTitle =
  content.seo?.title?.trim() || "Genevieve Navisotschnig | CultureWithGen";
const seoDescription =
  content.seo?.description?.trim() ||
  "Praxisorientierte Workshops für interkulturelle Kommunikation mit Genevieve Navisotschnig für internationale Teams - inhouse und online. Kontaktieren Sie mich noch heute.";
---

<html class="light" lang="de">
  <head>
    <Seo
      title={seoTitle}
      description={seoDescription}
      locale="de"
      path="/de/"
      alternates={{ en: "/", de: "/de/" }}
    />
    <StructuredData
      locale="de"
      path="/de/"
      offerItems={content.offer.items}
      description={seoDescription}
    />
  </head>

  <body class="antialiased overflow-x-hidden flex flex-col min-h-screen">
    <Navigation homeHref="/de/" links={navLinks} ctaLabel="Kontakt aufnehmen" />

    <main class="pt-16 md:pt-40 flex-1">
      <Hero {...content.header} />
      <Offer {...content.offer} />
      <About {...content.about} />
      <WhoFor {...content.whoFor} />
      <Situations {...content.situations} />
      <Formats {...content.format} />
      {
        content.testimonials && content.testimonials.visible !== false && (
          <Testimonials {...content.testimonials} />
        )
      }
      <Contact {...content.contact} ctaLabel={content.header.ctaLabel} />
    </main>

    <Footer locale="de" />

    <BackToTop locale="de" />
  </body>
</html>
