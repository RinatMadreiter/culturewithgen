---
import { getCollection, render } from "astro:content";
import LegalLayout from "../../layouts/LegalLayout.astro";
import { UI, LEGAL_ROUTES, type LegalDoc } from "../../lib/i18n";

// Generate /de/datenschutz and /de/impressum from the German legal markdown
// files in src/content/legal (prefixed with "de-"). The "de-" prefix is
// stripped from the URL slug.
export async function getStaticPaths() {
  const entries = await getCollection("legal");
  return entries
    .filter((entry) => entry.id.startsWith("de-"))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^de-/, "") },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/^de-/, "");

// The German slugs differ from the English ones, so map back to the shared
// document key to find the description and the English counterpart.
const doc = (Object.keys(LEGAL_ROUTES) as LegalDoc[]).find(
  (key) => LEGAL_ROUTES[key].de === `/de/${slug}`,
);
const routes = doc ? LEGAL_ROUTES[doc] : undefined;
const description = doc
  ? UI.de.legal.descriptions[doc]
  : (entry.data.title as string);
---

<LegalLayout
  lang="de"
  title={entry.data.title}
  description={description}
  path={routes?.de ?? `/de/${slug}`}
  alternates={routes}
>
  <Content />
</LegalLayout>
