---
import { getEntry } from "astro:content";

import "../styles/global.css";

import Navigation from "../components/Navigation.astro";
import Seo from "../components/Seo.astro";
import StructuredData from "../components/StructuredData.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Offer from "../components/sections/Offer.astro";
import About from "../components/sections/About.astro";
import WhoFor from "../components/sections/WhoFor.astro";
import Situations from "../components/sections/Situations.astro";
import Formats from "../components/sections/Formats.astro";
import Contact from "../components/sections/Contact.astro";
import BackToTop from "../components/BackToTop.astro";

const entry = await getEntry("landing", "en");
if (!entry)
  throw new Error("Missing landing content: src/content/landing/en.json");
const content = entry.data;

// SEO: keyword-rich title (primary service + brand) and a benefit-led,
// CTA-oriented description, both grounded in the page content. Each can be
// overridden via the CMS (content.seo); an empty/absent override falls back
// to the derived default below so nothing regresses when left blank.
const seoTitle =
  content.seo?.title?.trim() || "Genevieve Navisotschnig | CultureWithGen";
const seoDescription =
  content.seo?.description?.trim() ||
  "Practical intercultural communication workshops with Genevieve Navisotschnig for international teams - in-company and online. Get in touch today.";
---

<html class="light" lang="en">
  <head>
    <Seo
      title={seoTitle}
      description={seoDescription}
      locale="en"
      path="/"
      alternates={{ en: "/", de: "/de/" }}
    />
    <StructuredData
      locale="en"
      path="/"
      offerItems={content.offer.items}
      description={seoDescription}
    />
  </head>

  <body class="antialiased overflow-x-hidden flex flex-col min-h-screen">
    <Navigation
      homeHref="/"
      links={[
        { label: "Services", href: "#services" },
        { label: "About", href: "#about" },
        { label: "Workshops", href: "#formats" },
      ]}
      ctaLabel="Contact Me"
    />

    <main class="pt-16 md:pt-40 flex-1">
      <Hero {...content.header} />
      <Offer {...content.offer} />
      <About {...content.about} />
      <WhoFor {...content.whoFor} />
      <Situations {...content.situations} />
      <Formats {...content.format} />
      <Contact {...content.contact} />
    </main>

    <Footer locale="en" />

    <BackToTop locale="en" />
  </body>
</html>
