---
import { getCollection, render } from "astro:content";
import LegalLayout from "../layouts/LegalLayout.astro";
import { UI, LEGAL_ROUTES, type LegalDoc } from "../lib/i18n";

// Generate /privacy and /imprint from the English legal markdown files
// in src/content/legal (German files are prefixed with "de-").
export async function getStaticPaths() {
  const entries = await getCollection("legal");
  return entries
    .filter((entry) => !entry.id.startsWith("de-"))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Description and the German counterpart both come from the shared tables, so
// the hreflang pair cannot drift from the footer's links.
const doc = entry.id as LegalDoc;
const routes = LEGAL_ROUTES[doc];
const description = UI.en.legal.descriptions[doc] ?? entry.data.title;
---

<LegalLayout
  lang="en"
  title={entry.data.title}
  description={description}
  path={routes?.en ?? `/${entry.id}`}
  alternates={routes}
>
  <Content />
</LegalLayout>
