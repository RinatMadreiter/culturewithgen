---
// Schema.org JSON-LD for the home page.
import { type Locale, UI } from "../lib/i18n";
import {
  SITE_NAME,
  SITE_ORIGIN,
  DEFAULT_OG_IMAGE,
  absoluteUrl,
} from "../lib/site";

interface IconItem {
  icon: string;
  text: string;
}

interface Props {
  locale: Locale;
  path: string;
  image?: string;
  offerItems: IconItem[];
  description: string;
}

const {
  locale,
  path,
  image = DEFAULT_OG_IMAGE,
  offerItems,
  description,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_ORIGIN);
const abs = (p: string) => absoluteUrl(p, Astro.site);

const canonical = abs(path);

const { jobTitle, serviceType, areaServed: areaServedName } = UI[locale].schema;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.href}#website`,
      url: site.href,
      name: SITE_NAME,
      inLanguage: locale,
      description,
    },
    {
      "@type": "Person",
      "@id": `${site.href}#person`,
      name: "Genevieve Navisotschnig",
      jobTitle,
      image: abs(image),
      url: site.href,
      knowsLanguage: ["en", "de"],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${site.href}#business`,
      name: SITE_NAME,
      url: site.href,
      image: abs(image),
      description,
      serviceType,
      inLanguage: locale,
      availableLanguage: ["en", "de"],
      areaServed: { "@type": "Country", name: areaServedName },
      provider: { "@id": `${site.href}#person` },
      founder: { "@id": `${site.href}#person` },
      knowsAbout: offerItems.map((i) => i.text),
      makesOffer: {
        "@type": "OfferCatalog",
        name: serviceType,
        itemListElement: offerItems.map((i) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: i.text },
        })),
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        url: `${canonical}#contact`,
        availableLanguage: ["en", "de"],
      },
    },
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
/>
