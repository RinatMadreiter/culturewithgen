---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import logo from "../assets/logo.webp";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  homeHref: string;
  links: NavLink[];
  ctaLabel: string;
  contactFormUrl: string;
}

const { homeHref, links, ctaLabel, contactFormUrl } = Astro.props;
---

<nav class="fixed top-0 w-full z-50 backdrop-blur-md shadow-md tracking-tight">
  <div
    class="flex justify-between items-center px-4 md:px-8 py-4 max-w-7xl mx-auto"
  >
    <a
      href={homeHref}
      class="text-xl rounded-xl font-bold transition-transform hover:scale-105 shrink-0"
    >
      <Image
        alt="CultureWithGen Logo"
        class="h-20 rounded-3xl md:h-36 w-auto object-contain"
        src={logo}
        height={144}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="sr-only">CultureWithGen</span>
    </a>

    <div class="hidden lg:flex items-center space-x-8">
      {
        links.map((item) => (
          <a
            class="hover:underline transition-all duration-200"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center space-x-4 md:space-x-6 shrink-0">
      <div class="hidden lg:flex text-sm font-semibold tracking-wider gap-2">
        <a
          href="/"
          class="js-lang-en hover:underline transition-all duration-200">EN</a
        >
        <span>|</span>
        <a
          href="/de/"
          class="js-lang-de hover:underline transition-all duration-200">DE</a
        >
      </div>

      <a
        href={contactFormUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#9A442D] text-white px-4 py-2 md:px-6 rounded-lg font-bold shadow-[0_6px_20px_rgba(154,68,45,0.35)] hover:bg-[#7D3522] hover:shadow-[0_8px_24px_rgba(154,68,45,0.45)] hover:-translate-y-0.5 transition-all duration-200"
      >
        {ctaLabel}
      </a>

      <details id="mobile-nav" class="mobile-nav lg:hidden">
        <summary
          class="flex items-center justify-center cursor-pointer text-2xl transition-colors"
          aria-label="Open menu"
        >
          <Icon name="menu" />
        </summary>
        <div
          class="absolute left-0 right-0 top-full bg-white shadow-md border-t border-[#1E3932]/10 flex flex-col py-2"
        >
          {
            links.map((item) => (
              <a
                class="px-6 py-3 hover:bg-[#F4F7F5] transition-colors"
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }
          <div
            class="mt-2 flex border-t border-[#1E3932]/10 pt-2 text-sm font-semibold tracking-wider"
          >
            <a
              href="/"
              class="js-lang-en flex-1 px-6 py-3 hover:bg-[#F4F7F5] transition-colors"
              >EN</a
            >
            <a
              href="/de/"
              class="js-lang-de flex-1 px-6 py-3 hover:bg-[#F4F7F5] transition-colors"
              >DE</a
            >
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<style>
  .mobile-nav > summary {
    list-style: none;
  }
  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Two copies of the switcher render (desktop bar + mobile menu).
  const enLinks = document.querySelectorAll<HTMLAnchorElement>("a.js-lang-en");
  const deLinks = document.querySelectorAll<HTMLAnchorElement>("a.js-lang-de");

  function setLangHref(hash: string) {
    enLinks.forEach((a) => (a.href = "/" + hash));
    deLinks.forEach((a) => (a.href = "/de/" + hash));
  }

  // Observer, not per-scroll getBoundingClientRect: that cost ~185ms of
  // forced reflow. Do not convert this back to a scroll handler.
  const NAV_OFFSET = 96; // discount the fixed nav from the top of the viewport
  const visibleHeight = new Map<string, number>();

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        visibleHeight.set(
          entry.target.id,
          entry.isIntersecting ? entry.intersectionRect.height : 0,
        );
      }
      let activeId = "";
      let maxVisible = 0;
      for (const [id, height] of visibleHeight) {
        if (height > maxVisible) {
          maxVisible = height;
          activeId = id;
        }
      }
      if (activeId) setLangHref("#" + activeId);
    },
    {
      rootMargin: `-${NAV_OFFSET}px 0px 0px 0px`,
      // Sections taller than the viewport never reach a high ratio.
      threshold: Array.from({ length: 11 }, (_, i) => i / 10),
    },
  );

  document
    .querySelectorAll<HTMLElement>("section[id]")
    .forEach((section) => sectionObserver.observe(section));

  setLangHref(window.location.hash);

  window.addEventListener("hashchange", () =>
    setLangHref(window.location.hash),
  );

  const mobileNav = document.getElementById(
    "mobile-nav",
  ) as HTMLDetailsElement | null;
  if (mobileNav) {
    mobileNav.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        mobileNav.open = false;
      }),
    );
    document.addEventListener("click", (e) => {
      if (mobileNav.open && !mobileNav.contains(e.target as Node)) {
        mobileNav.open = false;
      }
    });
  }
</script>
