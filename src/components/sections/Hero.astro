---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { resolveImage, type CmsImage } from "../../lib/images";
import { CONTACT_FORM_URL } from "../../lib/links";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  description: string;
  ctaLabel: string;
  image?: CmsImage;
}

const { eyebrow, title, subtitle, description, ctaLabel, image } = Astro.props;

const asset = resolveImage(image?.src);
const alt = image?.alt || "Professional portrait of intercultural trainer";
---

<section class="relative pt-20 pb-10 lg:pb-32 px-6 lg:px-12 overflow-hidden">
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center"
  >
    <div
      class="lg:col-span-7 z-10 flex flex-col justify-center items-start lg:pr-12"
    >
      <p class="hero-name text-xl font-bold tracking-widest text-[#9A442D] mb-2">
        Genevieve Navisotschnig
      </p>
      {
        eyebrow && (
          <div class="flex items-center gap-2 mb-6 -mt-2">
            <Icon
              name="language"
              class="eyebrow-globe text-[#9A442D] text-xl leading-none"
            />
            <span class="hero-eyebrow-text text-sm font-semibold text-[#1E3932]/70 tracking-wide">
              {eyebrow}
            </span>
          </div>
        )
      }
      <h1
        class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.1] font-extrabold tracking-[-0.02em] mb-8"
      >
        {title}
      </h1>
      <p class="text-xl md:text-2xl font-medium mb-6 leading-relaxed">
        {subtitle}
      </p>
      <div
        class="rich-text text-base mb-8 lg:mb-12 leading-relaxed max-w-2xl"
        set:html={description}
      />
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <a
          href={CONTACT_FORM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-[#9A442D] text-white px-8 py-4 rounded-lg font-bold tracking-wider hover:bg-[#7D3522] transition-all duration-200 shadow-[0_10px_30px_rgba(154,68,45,0.35)] hover:shadow-[0_12px_36px_rgba(154,68,45,0.45)] hover:-translate-y-0.5 text-center"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
    <div class="lg:col-span-5 relative">
      <div
        class="absolute inset-0 rounded-[2rem] transform translate-x-4 translate-y-4 -z-10 opacity-10"
      >
      </div>
      {
        asset ? (
          <Image
            src={asset}
            alt={alt}
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 40vw, calc(100vw - 3rem)"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto object-cover rounded-[2rem] shadow-[0_12px_40px_rgba(30,57,50,0.12)] bg-gray-200 lg:min-h-[400px]"
          />
        ) : (
          image?.src && (
            <img
              alt={alt}
              class="w-full h-auto object-cover rounded-[2rem] shadow-[0_12px_40px_rgba(30,57,50,0.12)] bg-gray-200 lg:min-h-[400px]"
              loading="eager"
              src={image.src}
            />
          )
        )
      }
    </div>
  </div>
</section>
