---
import Icon from "../Icon.astro";

interface Props {
  title: string;
  text: string;
  location: string;
  ctaLabel: string;
  contactFormUrl: string;
}

const { title, text, location, ctaLabel, contactFormUrl } = Astro.props;
---

<section
  class="py-12 lg:py-24 px-6 lg:px-12 bg-[#1E3932] text-[#FAF9F6]"
  id="contact"
>
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl lg:text-[2.75rem] font-bold mb-4">
      {title}
    </h2>
    <p class="text-xl mb-8 lg:mb-16 text-[#FAF9F6]/85">
      {text}
    </p>
    <div class="flex flex-col items-center gap-8">
      <a
        href={contactFormUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#9A442D] text-white text-lg md:text-2xl font-bold px-8 py-4 rounded-full shadow-[0_12px_36px_rgba(154,68,45,0.45)] hover:bg-[#7D3522] hover:-translate-y-0.5 hover:shadow-[0_16px_44px_rgba(154,68,45,0.55)] transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FAF9F6]"
      >
        {ctaLabel}
      </a>
      <div class="flex items-center gap-2 text-base text-[#FAF9F6]/70">
        <Icon name="location_on" class="text-sm" />
        <span>{location}</span>
      </div>
    </div>
  </div>
</section>
