---
// Central SEO head component.
import { type Locale, otherLocale } from "../lib/i18n";
import { SITE_NAME, DEFAULT_OG_IMAGE, absoluteUrl } from "../lib/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Path of the current page, e.g. "/", "/de/", "/privacy". */
  path: string;
  /** Translated paths keyed by locale, used for hreflang alternates. */
  alternates?: Partial<Record<Locale, string>>;
  /** Root-relative or absolute path to the social share image. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  path,
  alternates,
  image = DEFAULT_OG_IMAGE,
  type = "website",
  noindex = false,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs.
const abs = (p: string) => absoluteUrl(p, Astro.site);

const canonical = abs(path);
const ogImage = abs(image);

const OG_LOCALE: Record<Locale, string> = { en: "en_GB", de: "de_AT" };
const altLocale = otherLocale(locale);

// Build the hreflang set (only when translated paths are provided). x-default
// points crawlers without a language preference at the English page.
const hreflangs = alternates
  ? [
      ...Object.entries(alternates).map(([loc, p]) => ({
        hreflang: loc,
        href: abs(p as string),
      })),
      ...(alternates.en
        ? [{ hreflang: "x-default", href: abs(alternates.en) }]
        : []),
    ]
  : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large"}
/>

{
  hreflangs.map((l) => (
    <link rel="alternate" hreflang={l.hreflang} href={l.href} />
  ))
}

<!-- Icons & theme. No SVG icon: the only vector source we had was a 1 MB PNG
     wrapped in an <svg>, which browsers fetched at High priority right across
     FCP. The .ico + 96px PNG cover every browser between them. -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#1E3932" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:locale:alternate" content={OG_LOCALE[altLocale]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
